###############################################################################
# Пример конфигурации observability-стека.
#
# Это НЕ рабочий .env — реальный файл создаётся автоматически скриптом
# deploy-observability-stack.sh при первом запуске (в /opt/observability/.env)
# со случайно сгенерированным паролем Grafana и placeholder-значениями для
# остальных полей. Этот файл в репозитории — просто справочный образец,
# показывающий, какие переменные существуют и как их заполнять.
###############################################################################

# --- Порты, публикуемые на хосте ---
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
BLACKBOX_PORT=9115
NODE_EXPORTER_PORT=9100
POSTGRES_EXPORTER_PORT=9187
LOKI_PORT=3100

# --- IP хоста, на котором крутится стек (нужен node-exporter'у, т.к. он в host network) ---
HOST_IP=203.0.113.10

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me

# --- Alertmanager: уведомления в Telegram ---
# 1) Создайте бота через @BotFather, получите TELEGRAM_BOT_TOKEN
# 2) Узнайте chat_id через https://api.telegram.org/bot<TOKEN>/getUpdates
#    после отправки сообщения в нужный чат/канал (для канала chat_id отрицательный)
TELEGRAM_BOT_TOKEN=123456:AAAA-BBBBCCCCddddEEEEffffGGGGhhh
TELEGRAM_CHAT_ID=-1001234567890

# --- Postgres Exporter: строка подключения к вашей БД ---
# Пользователь БД должен иметь права минимум pg_monitor (PostgreSQL 10+):
#   CREATE USER postgres_exporter WITH PASSWORD 'strong_password';
#   GRANT pg_monitor TO postgres_exporter;
# Обратите внимание на sslmode — если PostgreSQL не настроен на SSL,
# используйте sslmode=disable явно (пустое значение параметра приведёт
# к ошибке "SSL is not enabled on the server").
POSTGRES_EXPORTER_DSN=postgresql://postgres_exporter:change_me@203.0.113.20:5432/postgres?sslmode=disable

# --- Blackbox Exporter: список HTTP(S) целей для проверки, через запятую ---
# Пробуются модулем https_selfsigned (допускает самоподписанные сертификаты;
# для обычного http:// TLS-настройки просто не применяются).
BLACKBOX_TARGETS=https://example.com,https://internal-host.local:8443,http://192.0.2.30:80

# --- Список хостов node-exporter, если у вас их несколько (через запятую, host:port) ---
NODE_EXPORTER_TARGETS=203.0.113.10:9100

# --- Blackbox Exporter: отдельный список целей для ICMP ping (через запятую, только host/IP, без :port) ---
# Независим от NODE_EXPORTER_TARGETS и BLACKBOX_TARGETS. Пусто = ICMP-пробинг отключён.
BLACKBOX_ICMP_TARGETS=

# --- Данные хранения (retention) Prometheus ---
PROMETHEUS_RETENTION=30d
