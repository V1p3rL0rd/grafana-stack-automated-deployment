###############################################################################
# Observability stack configuration example.
#
# This is NOT a working .env file — the real file is automatically created by the
# deploy-observability-stack.sh script on first run (at /opt/observability/.env)
# with a randomly generated Grafana password and placeholder values for the
# remaining fields. This file in the repository is simply a reference template
# showing what variables exist and how to populate them.
###############################################################################

# --- Ports published on the host ---
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
BLACKBOX_PORT=9115
NODE_EXPORTER_PORT=9100
POSTGRES_EXPORTER_PORT=9187
LOKI_PORT=3100

# --- Host IP where the stack runs (needed by node-exporter because it uses the host network) ---
HOST_IP=203.0.113.10

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me

# --- Alertmanager: Telegram notifications ---
# 1) Create a bot via @BotFather to get TELEGRAM_BOT_TOKEN
# 2) Find your chat_id via https://api.telegram.org/bot<TOKEN>/getUpdates
#    after sending a message to the desired chat/channel (channel chat_ids are negative)
TELEGRAM_BOT_TOKEN=123456:AAAA-BBBBCCCCddddEEEEffffGGGGhhh
TELEGRAM_CHAT_ID=-1001234567890

# --- Postgres Exporter: connection string to your DB ---
# The database user must have at least pg_monitor privileges (PostgreSQL 10+):
#   CREATE USER postgres_exporter WITH PASSWORD 'strong_password';
#   GRANT pg_monitor TO postgres_exporter;
# Note on sslmode — if PostgreSQL is not configured for SSL, explicitly use
# sslmode=disable (leaving the parameter empty will result in the error
# "SSL is not enabled on the server").
POSTGRES_EXPORTER_DSN=postgresql://postgres_exporter:change_me@203.0.113.20:5432/postgres?sslmode=disable

# --- Blackbox Exporter: comma-separated list of HTTP(S) targets to check ---
# Probed using the https_selfsigned module (allows self-signed certificates;
# TLS settings are simply ignored for regular http:// targets).
BLACKBOX_TARGETS=https://example.com,https://internal-host.local:8443,http://192.0.2.30:80

# --- List of node-exporter hosts, if you have multiple (comma-separated, host:port) ---
NODE_EXPORTER_TARGETS=203.0.113.10:9100

# --- Blackbox Exporter: separate list of targets for ICMP ping (comma-separated, host/IP only, without :port) ---
# Independent of NODE_EXPORTER_TARGETS and BLACKBOX_TARGETS. Empty = ICMP probing disabled.
BLACKBOX_ICMP_TARGETS=

# --- Prometheus data retention ---
PROMETHEUS_RETENTION=30d
